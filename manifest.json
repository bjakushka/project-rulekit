{
  "core": {
    "rules": ["CLAUDE.md"],
    "scaffold": ["PROJECT.tmpl.md"]
  },
  "modules": {
    "backlog": {
      "group": null,
      "load": "always",
      "required": false,
      "scaffold": ["backlog/example-task.tmpl.md"],
      "skills": []
    },
    "inbox": {
      "group": null,
      "load": "always",
      "required": true,
      "scaffold": ["inbox.tmpl.md"],
      "skills": []
    },
    "llm_instructions": {
      "group": null,
      "load": "always",
      "required": false,
      "scaffold": [],
      "skills": []
    },
    "project-context": {
      "group": null,
      "load": "always",
      "required": true,
      "scaffold": [],
      "skills": []
    },
    "secrets": {
      "group": null,
      "load": "always",
      "required": true,
      "scaffold": [],
      "skills": []
    },
    "type_coding": {
      "group": "type",
      "load": "always",
      "required": true,
      "scaffold": [],
      "skills": []
    },
    "type_non-coding": {
      "group": "type",
      "load": "always",
      "required": true,
      "scaffold": [],
      "skills": []
    },
    "vcs": {
      "group": null,
      "load": "always",
      "required": true,
      "scaffold": [],
      "skills": []
    }
  },
  "paths": {
    "hooks": ".claude/hooks/",
    "rules": "rules/",
    "skills": ".claude/skills/"
  },
  "values": {
    "CONVERSATION_LANGUAGE": {
      "choices": null,
      "default": "English",
      "prompt": "Which language should the assistant use for conversation?",
      "required": true
    },
    "VERSION_CONTROL": {
      "choices": ["Git"],
      "default": "Git",
      "prompt": "Which version control system should the project use?",
      "required": true
    }
  }
}
